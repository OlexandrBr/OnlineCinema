@model Movie
@inject MovieStorage Storage

<h1>@Model.Title</h1>
<p class="genre">@Model.Genre</p>

<video controls poster="@Storage.GetSasUrl(Model.PosterBlob)">
    <source src="@Storage.GetSasUrl(Model.VideoBlob)" />
</video>

<p>@Model.Description</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="delete">Видалити фільм</button>
</form>
